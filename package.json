{
  "name": "lois-votes",
  "version": "0.0.0",
  "description": "Qui a voté quoi ? : quel parti a voté quoi pour chaque loi à l'Assemblée nationale (17e législature).",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run build:fixtures && node dist/lois-votes/server/server.mjs",
    "build": "npm run donnees && ng build && node scripts/copier-donnees.mjs",
    "build:fixtures": "DONNEES_DEPUIS=fixtures npm run build",
    "e2e": "npm run build:fixtures && playwright test",
    "perf": "npm run build:fixtures && node scripts/perf.mjs",
    "test": "ng test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json",
    "donnees": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/donnees/index.mjs",
    "icones": "node scripts/icones.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr": "node dist/lois-votes/server/server.mjs"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "fuda": "github:phamelin42/design-system-fuda#2111c2c21d2d59bd32c6ec798fe9f6d871b34637",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "fflate": "0.8.2",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
