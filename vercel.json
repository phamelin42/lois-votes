{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/lois-votes/**"
    }
  },
  "headers": [
    {
      "source": "/(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|icon-48\\.png|icon-192\\.png|icon-512\\.png|site\\.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
